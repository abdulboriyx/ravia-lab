{
  "name": "ravia-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:spatial": "node --test app/code/spatial-ravia/*.test.ts",
    "eval:spatial": "npm run test:spatial",
    "eval:spatial:semantic-holdout": "tsx scripts/run-spatial-ravia-semantic-holdout.ts",
    "eval:spatial:dna-family-benchmark": "tsx scripts/run-spatial-ravia-dna-family-benchmark.ts",
    "eval:spatial:dna-mechanism-benchmark": "tsx scripts/run-spatial-ravia-dna-mechanism-benchmark.ts",
    "eval:spatial:transcription-holdout": "tsx scripts/run-spatial-ravia-transcription-holdout.ts",
    "eval:spatial:translation-holdout": "tsx scripts/run-spatial-ravia-translation-holdout.ts",
    "eval:spatial:signaling-holdout": "tsx scripts/run-spatial-ravia-signaling-holdout.ts",
    "eval:spatial:action-potential-holdout": "tsx scripts/run-spatial-ravia-action-potential-holdout.ts",
    "smoke:spatial": "npm run test:spatial",
    "holdout:spatial": "npm run test:spatial",
    "holdout:spatial:regression": "npm run test:spatial"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "molstar": "^5.11.0",
    "next": "^16.2.11",
    "openai": "^7.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
